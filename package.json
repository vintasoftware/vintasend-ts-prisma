{
  "name": "vintasend-prisma",
  "version": "1.0.0-alpha8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vintasend-ts-prisma.git"
  },
  "description": "VintaSend Backend implementation for Prisma",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "author": "Hugo Bessa",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "prisma": "^7.10.1",
    "vintasend": "^1.0.0-alpha8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
